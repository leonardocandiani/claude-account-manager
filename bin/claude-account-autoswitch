#!/usr/bin/env bash
# Headless account switcher for Claude Code. Runs from launchd every few minutes,
# measures every profile through `claude-account measure` and switches the active
# profile so the quota that resets first is used first, never draining an account to
# nothing while another one still has room.
# Zero AI, zero token spent beyond one haiku output token per profile per run.
#
# Policy file: $CONFIG_DIR/policy.json
#   {
#     "preferred": "work",
#     "fallback": "personal",
#     "reserves": ["third"],          (optional: more accounts, in order, after the fallback)
#     "exhausted_at": {"five_hour": 0.95, "seven_day": 0.97},
#     "return_below": {"five_hour": 0.70, "seven_day": 0.90},
#     "floor": {"seven_day": 0.10, "release_hours": 24},
#     "min_switch_interval_min": 10,
#     "max_switches_per_day": 12
#   }
# Order of use: the account whose weekly quota resets first goes first (the chain order only
# breaks ties), so no quota is left to expire unused. Each account keeps `floor.seven_day` of
# its week as a reserve until the last `release_hours` before its reset; a floor is used only
# when every other account is down to its own. A move to an account that resets sooner needs
# (exhausted_at.seven_day - return_below.seven_day) of room above its floor, so a switch is
# worth the restart it costs.
# Kill switch: touch $CONFIG_DIR/autoswitch.off
set -uo pipefail

CONFIG_DIR="${CLAUDE_ACCOUNT_HOME:-$HOME/.config/claude-account}"
POLICY="$CONFIG_DIR/policy.json"
STATE="$CONFIG_DIR/autoswitch-state.json"
LOG="$CONFIG_DIR/autoswitch.log"
OFF="$CONFIG_DIR/autoswitch.off"
CLI="$HOME/bin/claude-account"

dry_run=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    -h|--help)
      echo "usage: claude-account-autoswitch [--dry-run]"
      echo "Measures every profile and switches when policy says so. Exit 0 always except usage error (2)."
      exit 0 ;;
    *) echo "error: unknown flag $arg" >&2; echo "help: claude-account-autoswitch [--dry-run]" >&2; exit 2 ;;
  esac
done

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '%s %s\n' "$(now_iso)" "$*" | tee -a "$LOG"; }


[ -x "$CLI" ] || { log "error=cli_missing path=$CLI"; exit 1; }
# The other machines in mirror.json follow a new or renewed token on the next run, whatever
# this run decides (it logs to mirror.log, and only when something moved).
[ "$dry_run" = true ] || trap '"$CLI" mirror --auto >/dev/null 2>&1 || true' EXIT
# And tokens another machine mirrored here are imported before measuring, so they count now.
[ "$dry_run" = true ] || "$CLI" mirror-import >/dev/null 2>&1 || true
[ -f "$POLICY" ] || { log "error=policy_missing path=$POLICY"; exit 1; }
if [ -e "$OFF" ]; then log "skip=kill_switch file=$OFF"; exit 0; fi

# Opt-in (policy "move_agents": true): background sessions follow automatic switches,
# and a move deferred while one was busy is finished here once they are all idle. When
# they sit on an account with no room left, waiting would leave them working on an
# exhausted quota for hours (measured 16/10/2026), so the move is forced: a busy session
# is cut and resumed by id with the wake prompt (force_stuck_move, ADR-007). Without the
# opt-in nothing is touched.
move_agents="$(jq -r '.move_agents // false' "$POLICY" 2>/dev/null || echo false)"
# Waiting for every session to be idle at once never ends with twenty of them: on 30/10/2026
# a move had waited 20 hours. After move_wait_min (default 15) of waiting the move is forced.
if [ "$move_agents" = true ] && [ "$dry_run" = false ] && [ -f "$CONFIG_DIR/bg-restart.pending" ]; then
  move_wait="$(jq -r '.move_wait_min // 15' "$POLICY" 2>/dev/null || echo 15)"
  case "$move_wait" in ''|*[!0-9]*) move_wait=15 ;; esac
  pending_at="$(stat -f %m "$CONFIG_DIR/bg-restart.pending" 2>/dev/null || date -u +%s)"
  move_args=(--if-pending)
  [ $(( $(date -u +%s) - pending_at )) -ge $((move_wait * 60)) ] && move_args+=(--force)
  log "bg_restart_pending ${move_args[*]} $("$CLI" bg-restart "${move_args[@]}" 2>&1 | tr '\n' ' ' | cut -c1-200)"
fi

pref="$(jq -r '.preferred // empty' "$POLICY")"
fall="$(jq -r '.fallback // empty' "$POLICY")"
chain=("$pref")
[ -n "$fall" ] && chain+=("$fall")
while IFS= read -r r; do [ -n "$r" ] && chain+=("$r"); done < <(jq -r '.reserves // [] | .[]' "$POLICY")
t5="$(jq -r '.exhausted_at.five_hour // 0.95' "$POLICY")"
t7="$(jq -r '.exhausted_at.seven_day // 0.97' "$POLICY")"
b5="$(jq -r '.return_below.five_hour // 0.70' "$POLICY")"
b7="$(jq -r '.return_below.seven_day // 0.90' "$POLICY")"
fl7="$(jq -r '.floor.seven_day // 0.10' "$POLICY")"
flh="$(jq -r '.floor.release_hours // 24' "$POLICY")"
min_int="$(jq -r '.min_switch_interval_min // 10' "$POLICY")"
max_day="$(jq -r '.max_switches_per_day // 12' "$POLICY")"

active="$(tr -d '[:space:]' < "$CONFIG_DIR/active" 2>/dev/null || true)"
measured="$("$CLI" measure "${chain[@]}" 2>/dev/null | tail -n +2 | sed 's/^  //')"
line_of() { printf '%s\n' "$measured" | grep "^$1," || true; }
line_pref="$(line_of "$pref")"
line_fall="$(line_of "$fall")"

field() { printf '%s' "$1" | cut -d, -f"$2"; }

# Cache legivel da medicao (a statusline le daqui: o payload do Claude Code so
# atualiza quando a propria sessao recebe resposta, entao fica velho em sessao
# parada). Fracoes 0-1 dos headers viram 0-100 aqui.
# Guarda tambem as ultimas 24 amostras (2h) de uso da janela de 5h por perfil:
# e o que permite ler o PADRAO de consumo (sparkline e tendencia), nao so o nivel.
MEASURE_CACHE="$CONFIG_DIR/measure.json"
prev_hist="$(jq -c '.history // {}' "$MEASURE_CACHE" 2>/dev/null || echo '{}')"
printf '%s\n' "$measured" | jq -R -s --arg at "$(now_iso)" --argjson ts "$(date -u +%s)" --argjson hist "$prev_hist" '
  split("\n") | map(select(length > 0) | split(",")) |
  map({key: .[0], value: {status: .[1], util_5h: ((.[3] | tonumber? // null) | if . == null then null else (. * 100 | round) end),
       reset_5h: (.[4] | tonumber? // null), util_7d: ((.[5] | tonumber? // null) | if . == null then null else (. * 100 | round) end),
       reset_7d: (.[6] | tonumber? // null), overage: (.[7] // null), overage_in_use: (.[8] == "true")}}) | from_entries as $p |
  {measured_at: $at, profiles: $p,
   history: ($p | to_entries | map({key: .key, value: ((($hist[.key] // []) + [[$ts, .value.util_5h]]) | .[-24:])}) | from_entries)}' \
  > "$MEASURE_CACHE.tmp" 2>/dev/null && mv "$MEASURE_CACHE.tmp" "$MEASURE_CACHE"
# Every measurement advances the regime (hysteresis counts measurements, not reads).
"$(dirname "$CLI")/claude-account-regime" --json >/dev/null 2>&1 || true

# tier <name>: what an account can still take. 0: room above its floor, enough to be worth
# a switch; 1: room above its floor; 2: only its floor left; 9: nothing under exhausted_at,
# or no reading. The floor is released in the last release_hours before the weekly reset
# (an unknown reset keeps it): that quota expires anyway, so all of it is fair game.
now_s="$(date -u +%s)"
tier() {
  local l
  l="$(line_of "$1")"
  [ "$(field "$l" 2)" = allowed ] || { echo 9; return 0; }
  awk -v u5="$(field "$l" 4)" -v u7="$(field "$l" 6)" -v r7="$(field "$l" 7)" -v now="$now_s" \
    -v t5="$t5" -v t7="$t7" -v b7="$b7" -v fl="$fl7" -v flh="$flh" 'BEGIN{
      if (u5 + 0 >= t5 + 0 || u7 + 0 >= t7 + 0) { print 9; exit }
      if (r7 + 0 > 0 && r7 - now <= flh * 3600) fl = 0
      room = t7 - fl - u7
      print (room >= t7 - b7 - 1e-9) ? 0 : (room > 1e-9 ? 1 : 2) }'
}
under_b5() { awk -v u="$(field "$(line_of "$1")" 4)" -v b="$b5" 'BEGIN{exit !(u + 0 < b + 0)}'; }

# 0 when the account has a real quota reading. No measuring token, an expired login or the
# API down read as unmeasurable or unknown: that is no reading, never a full account.
measured_ok() {
  case "$(field "$(line_of "$1")" 2)" in allowed|rejected) return 0 ;; *) return 1 ;; esac
}

# The move is forced when the daemon still runs on an account of the chain that has no
# room under exhausted_at: a move left pending, or a switch that left the sessions behind
# on purpose (--no-restart, --keep-agents), which marks nothing pending. On 26/10/2026 a
# manual switch to proteauto on the MacBook left the daemon recorded on leo-iacall, at 98%
# since, and no run looked at it. A restart in flight is left to finish. Runs before the
# decision and again after a switch.
force_stuck_move() {
  [ "$move_agents" = true ] && [ "$dry_run" = false ] || return 0
  local on lock_at
  # The restart records the new account and then removes its lock, so the lock is read
  # first: once it is gone, daemon-profile is current. It can vanish while being read.
  if lock_at="$(stat -f %m "$CONFIG_DIR/bg-restart.lock" 2>/dev/null)"; then
    [ $(( $(date -u +%s) - lock_at )) -lt 600 ] && return 0
  elif [ -d "$CONFIG_DIR/bg-restart.lock" ]; then
    return 0
  fi
  on="$(tr -d '[:space:]' < "$CONFIG_DIR/daemon-profile" 2>/dev/null || true)"
  [ -f "$CONFIG_DIR/bg-restart.pending" ] || [ "$on" != "$(tr -d '[:space:]' < "$CONFIG_DIR/active" 2>/dev/null)" ] || return 0
  [ -n "$on" ] && in_chain "$on" || return 0
  measured_ok "$on" || return 0
  [ "$(tier "$on")" -lt 9 ] && return 0
  log "bg_restart_forced sessions_on=$on (no room left) $("$CLI" bg-restart --force 2>&1 | tr '\n' ' ' | cut -c1-200)"
}

decision="$active"; reason=stay
in_chain() { local p; for p in "${chain[@]}"; do [ "$p" = "$1" ] && return 0; done; return 1; }
# An account whose switch failed (a login that no longer signs in, refused by `use`) is
# quarantined for quarantine_hours: no switch goes to it, and the next account with room is
# tried in the same run. The quota reading alone cannot see a dead login: on 22/10/2026 the
# measuring token said allowed while the login was revoked, and the run stopped on it.
QUARANTINE="$CONFIG_DIR/autoswitch-quarantine.json"
quar_h="$(jq -r '.quarantine_hours // 6' "$POLICY")"
case "$quar_h" in ''|*[!0-9]*) quar_h=6 ;; esac
quarantined() {
  local until
  until="$(jq -r --arg n "$1" '.[$n].until // 0' "$QUARANTINE" 2>/dev/null || echo 0)"
  case "$until" in ''|*[!0-9]*) return 1 ;; esac
  [ "$until" -gt "$(date -u +%s)" ]
}
quarantine() { # name reason
  local q
  q="$(jq -ce 'if type == "object" then . else error end' "$QUARANTINE" 2>/dev/null || echo '{}')"
  jq -n --argjson q "$q" --arg n "$1" --arg r "$2" --argjson u $(( $(date -u +%s) + quar_h * 3600 )) \
    '$q + {($n): {until: $u, reason: $r}}' > "$QUARANTINE.tmp" && mv "$QUARANTINE.tmp" "$QUARANTINE"
}

# The chain sorted by weekly reset, soonest first; an unknown reset goes last and the chain
# order breaks ties. Quota that resets first is used first, so none expires unused.
reset_order() {
  local i=0 p r
  for p in "${chain[@]}"; do
    r="$(field "$(line_of "$p")" 7)"
    case "$r" in ''|*[!0-9]*|0) r=9999999999 ;; esac
    printf '%s %03d %s\n' "$r" "$i" "$p"; i=$((i + 1))
  done | sort -k1,1n -k2,2n | awk '{print $3}'
}
ordered=()
while IFS= read -r p; do ordered+=("$p"); done < <(reset_order)
chain_index() { local i; for i in "${!chain[@]}"; do [ "${chain[$i]}" = "$1" ] && { echo "$i"; return 0; }; done; echo 99; }

# best_target [except]: "name tier" of the account to move to: the lowest tier, then the
# soonest reset. Nothing printed when no account of the chain can take traffic.
best_target() {
  local p t bt=9 bp=""
  for p in "${ordered[@]}"; do
    [ "$p" = "${1:-}" ] && continue
    quarantined "$p" && continue
    t="$(tier "$p")"
    [ "$t" -lt "$bt" ] && { bt="$t"; bp="$p"; }
  done
  [ -n "$bp" ] && printf '%s %s\n' "$bp" "$bt"
  return 0
}

# up_target: an account that resets before the active one, with room worth a switch and a
# five-hour window that really recovered (hysteresis).
up_target() {
  local p
  for p in "${ordered[@]}"; do
    [ "$p" = "$active_eff" ] && return 1
    quarantined "$p" && continue
    [ "$(tier "$p")" = 0 ] && under_b5 "$p" && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}
force_stuck_move
[ -z "$active" ] && active_eff="$pref" || active_eff="$active"
# A manual switch is respected: when the active profile is not the one the last
# automatic switch chose, a person picked it, and the switcher leaves it alone until it is
# down to its floor while another account of the chain has more than its own floor.
last_to="$(jq -r '.to // empty' "$STATE" 2>/dev/null || true)"
best=""; best_t=9
read -r best best_t < <(best_target "$active_eff") || true
if ! in_chain "$active_eff"; then
  # A profile outside the policy is active (manual choice); never override it.
  decision="$active"; reason=manual_profile_active
elif ! measured_ok "$active_eff"; then
  # Without a reading the switcher cannot tell full from fine; it stays (22/10/2026: a
  # native profile without a measuring token read as exhausted and was left every 5 min).
  decision="$active"; reason=active_unmeasured
else
  at="$(tier "$active_eff")"
  if [ -n "$active" ] && [ -n "$last_to" ] && [ "$active" != "$last_to" ]; then
    if [ "$at" -le 1 ] || [ -z "$best" ] || [ "$best_t" -ge "$at" ]; then
      decision="$active"; reason=manual_choice_respected
    else
      decision="$best"; [ "$at" = 9 ] && reason=manual_choice_exhausted || reason=manual_choice_at_floor
    fi
  elif up="$(up_target)"; then
    decision="$up"
    if [ "$(chain_index "$up")" -lt "$(chain_index "$active_eff")" ]; then
      [ "$up" = "$pref" ] && reason=preferred_recovered || reason=fallback_recovered
    elif [ "$at" = 9 ]; then reason=exhausted_next_has_room
    elif [ "$at" = 2 ]; then reason=at_floor_next_has_room
    else reason=resets_sooner_has_room; fi
  elif [ "$at" -le 1 ]; then
    decision="$active_eff"
    case "$active_eff" in "$pref") reason=preferred_has_room ;; "$fall") reason=fallback_still_has_room ;; *) reason=reserve_still_has_room ;; esac
  elif [ -n "$best" ] && [ "$best_t" -lt "$at" ]; then
    decision="$best"
    if [ "$at" = 2 ]; then reason=at_floor_next_has_room
    elif [ "$active_eff" = "$pref" ] && [ "$best" = "$fall" ]; then reason=preferred_exhausted_fallback_has_room
    elif [ "$active_eff" = "$fall" ] && [ "$best" = "$pref" ]; then reason=fallback_exhausted_preferred_has_room
    else reason=exhausted_next_has_room; fi
  elif [ "$at" = 2 ]; then
    decision="$active_eff"; reason=floor_in_use_no_other_room
  else
    decision="$active_eff"
    [ "$active_eff" = "$pref" ] && reason=both_exhausted_stay_preferred || reason=both_exhausted_stay
  fi
fi

summary="active=$active decision=$decision reason=$reason pref=[$(field "$line_pref" 2)/5h=$(field "$line_pref" 4)/7d=$(field "$line_pref" 6)] fall=[$(field "$line_fall" 2)/5h=$(field "$line_fall" 4)/7d=$(field "$line_fall" 6)]"
for r in "${chain[@]:2}"; do
  l="$(line_of "$r")"
  summary="$summary $r=[$(field "$l" 2)/5h=$(field "$l" 4)/7d=$(field "$l" 6)]"
done
summary="$summary order=$(IFS=,; printf '%s' "${ordered[*]}")"

if [ "$decision" = "$active" ]; then
  log "$summary"
  exit 0
fi

# Guard rails: minimum interval between switches and a hard daily cap.
last_ts="$(jq -r '.lastSwitchAt // 0' "$STATE" 2>/dev/null || echo 0)"
today="$(date -u +%Y-%m-%d)"
count_today="$(jq -r --arg d "$today" 'if .day == $d then (.count // 0) else 0 end' "$STATE" 2>/dev/null || echo 0)"
now_epoch="$(date -u +%s)"
if [ $((now_epoch - last_ts)) -lt $((min_int * 60)) ]; then
  log "$summary held=min_interval"
  exit 0
fi
if [ "$count_today" -ge "$max_day" ]; then
  log "$summary held=daily_cap($max_day)"
  exit 0
fi

if [ "$dry_run" = true ]; then
  log "$summary dry_run=would_switch"
  exit 0
fi

# Headless: never restart Orca or cut a session short. With move_agents, background
# sessions are moved (same ids, deferred while one is busy).
use_args=(--no-restart)
[ "$move_agents" = true ] && use_args+=(--move-agents)
# Each refused target is quarantined and the next account with room is tried, one per chain
# member at most, so a dead login never leaves the sessions on an exhausted account.
tries=0
while [ -n "$decision" ] && [ "$decision" != "$active" ] && [ "$tries" -lt "${#chain[@]}" ]; do
  tries=$((tries + 1))
  if out="$("$CLI" use "$decision" "${use_args[@]}" 2>&1)"; then
    jq -n --arg d "$today" --argjson c $((count_today + 1)) --argjson t "$now_epoch" \
      --arg from "$active" --arg to "$decision" --arg why "$reason" \
      '{day:$d,count:$c,lastSwitchAt:$t,from:$from,to:$to,reason:$why}' > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    log "$summary switched=$active->$decision move=$(printf '%s' "$out" | grep -o 'bg-restart: .*' | head -1 | cut -c1-120)"
    force_stuck_move
    exit 0
  fi
  why="$(printf '%s' "$out" | tr '\n' ' ' | sed 's/claude-account: ERROR: //' | cut -c1-200)"
  quarantine "$decision" "$why"
  log "$summary switch_failed=$decision quarantined=${quar_h}h reason=$why"
  # A refused move up (back to a recovered account) is no reason to move down: while the
  # active account still has room above its floor, it stays.
  at="$(tier "$active_eff")"
  if measured_ok "$active_eff" && [ "$at" -le 1 ]; then
    log "active=$active decision=$active reason=stays_after_failed_switch"
    exit 0
  fi
  next=""; next_t=9
  read -r next next_t < <(best_target "$active_eff") || true
  if [ -n "$next" ] && [ "$next_t" -lt "$at" ] && [ "$next" != "$active" ]; then
    summary="active=$active decision=$next reason=fallback_after_failed_switch"
    decision="$next"
  else
    log "active=$active decision=$active reason=no_healthy_account_left (stays)"
    exit 0
  fi
done
exit 0
